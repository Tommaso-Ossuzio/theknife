<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Finestra di registrazione.

    Il ruolo è una scelta esclusiva: un account è Cliente OPPURE Ristoratore.
    La doppia appartenenza non è più prevista.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.RegisterController"
            stylesheets="@style.css"
            styleClass="dialog-root"
            prefWidth="460" prefHeight="720">

    <fx:define>
        <ToggleGroup fx:id="gruppoRuolo"/>
    </fx:define>

    <top>
        <VBox styleClass="dialog-header">
            <Label text="Crea il tuo account" styleClass="page-title"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="form-body">

                <VBox styleClass="field-group">
                    <Label text="NOME *" styleClass="field-label"/>
                    <TextField fx:id="campoNome" promptText="Il tuo nome"/>
                </VBox>

                <VBox styleClass="field-group">
                    <Label text="COGNOME *" styleClass="field-label"/>
                    <TextField fx:id="campoCognome" promptText="Il tuo cognome"/>
                </VBox>

                <VBox styleClass="field-group">
                    <Label text="USERNAME *" styleClass="field-label"/>
                    <TextField fx:id="campoUsername" promptText="Scegli uno username"/>
                </VBox>

                <VBox styleClass="field-group">
                    <Label text="PASSWORD *" styleClass="field-label"/>
                    <PasswordField fx:id="campoPassword" promptText="Scegli una password"/>
                </VBox>

                <VBox styleClass="field-group">
                    <Label text="CITTÀ / DOMICILIO *" styleClass="field-label"/>
                    <TextField fx:id="campoCitta" promptText="Es. Varese"/>
                </VBox>

                <VBox styleClass="field-group">
                    <Label text="DATA DI NASCITA" styleClass="field-label"/>
                    <DatePicker fx:id="campoDataNascita" promptText="Facoltativo"/>
                </VBox>

                <Separator/>

                <!-- SCELTA DEL RUOLO: esclusiva -->
                <VBox styleClass="field-group">
                    <Label text="COME VUOI USARE THEKNIFE?" styleClass="field-label"/>

                    <HBox styleClass="role-row">
                        <VBox styleClass="role-option" onMouseClicked="#onScegliCliente" HBox.hgrow="ALWAYS">
                            <RadioButton fx:id="radioCliente"
                                         text="Cliente"
                                         toggleGroup="$gruppoRuolo"
                                         selected="true"/>
                        </VBox>

                        <VBox styleClass="role-option" onMouseClicked="#onScegliRistoratore" HBox.hgrow="ALWAYS">
                            <RadioButton fx:id="radioRistoratore"
                                         text="Ristoratore"
                                         toggleGroup="$gruppoRuolo"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Label fx:id="etichettaErrore" styleClass="error-label" wrapText="true"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer">
            <Button onAction="#onBack" text="Annulla" styleClass="btn-secondary"/>
            <Button onAction="#onCreate" text="Crea account" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
