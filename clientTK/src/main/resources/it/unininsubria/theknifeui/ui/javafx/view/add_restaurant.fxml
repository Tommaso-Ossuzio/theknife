<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.AddRestaurantController"
            stylesheets="@style.css"
            styleClass="dialog-root"
            prefWidth="700" prefHeight="760">

    <top>
        <VBox styleClass="dialog-header">
            <Label text="Nuovo ristorante" styleClass="page-title"/>
            <Label text="Inserisci i dati della tua attività: i campi con * sono obbligatori."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="form-body">

                <VBox styleClass="field-group">
                    <Label text="NOME *" styleClass="field-label"/>
                    <HBox styleClass="field-row">
                        <TextField fx:id="campoNome" promptText="Nome ristorante" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="erroreNome" styleClass="error-label" minWidth="-Infinity"/>
                    </HBox>
                </VBox>

                <Label text="Dove si trova" styleClass="section-title"/>

                <HBox styleClass="card-line">
                    <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="NAZIONE *" styleClass="field-label"/>
                        <HBox styleClass="field-row">
                            <TextField fx:id="campoNazione" promptText="es. Italia" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="erroreNazione" styleClass="error-label" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="CITTÀ *" styleClass="field-label"/>
                        <HBox styleClass="field-row">
                            <TextField fx:id="campoCitta" promptText="es. Milano" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="erroreCitta" styleClass="error-label" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                </HBox>

                <VBox styleClass="field-group">
                    <Label text="INDIRIZZO *" styleClass="field-label"/>
                    <HBox styleClass="field-row">
                        <TextField fx:id="campoIndirizzo" promptText="Via..." HBox.hgrow="ALWAYS"/>
                        <Label fx:id="erroreIndirizzo" styleClass="error-label" minWidth="-Infinity"/>
                    </HBox>
                </VBox>

                <HBox styleClass="card-line">
                    <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="LATITUDINE *" styleClass="field-label"/>
                        <HBox styleClass="field-row">
                            <TextField fx:id="campoLatitudine" promptText="45.46" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="erroreLatitudine" styleClass="error-label" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="LONGITUDINE *" styleClass="field-label"/>
                        <HBox styleClass="field-row">
                            <TextField fx:id="campoLongitudine" promptText="9.18" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="erroreLongitudine" styleClass="error-label" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <Label text="Dettagli e contatti" styleClass="section-title"/>

                <VBox styleClass="field-group">
                    <Label text="NUMERO DI TELEFONO *" styleClass="field-label"/>
                    <HBox styleClass="field-row">
                        <TextField fx:id="campoTelefono" promptText="es. +39..." HBox.hgrow="ALWAYS"/>
                        <Label fx:id="erroreTelefono" styleClass="error-label" minWidth="-Infinity"/>
                    </HBox>
                </VBox>

                <HBox styleClass="card-line">
                    <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="PREZZO MEDIO (€) *" styleClass="field-label"/>
                        <HBox styleClass="field-row">
                            <TextField fx:id="campoPrezzo" promptText="es. 60" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="errorePrezzo" styleClass="error-label" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="TIPO DI CUCINA *" styleClass="field-label"/>
                        <HBox styleClass="field-row">
                            <TextField fx:id="campoTipoCucina" promptText="Italian, Gourmet..." HBox.hgrow="ALWAYS"/>
                            <Label fx:id="erroreTipoCucina" styleClass="error-label" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                </HBox>

                <VBox styleClass="field-group">
                    <Label text="SITO WEB" styleClass="field-label"/>
                    <TextField fx:id="campoSitoWeb" promptText="https://..."/>
                </VBox>

                <VBox styleClass="field-group">
                    <Label text="STELLE MICHELIN" styleClass="field-label"/>
                    <HBox styleClass="card-line">
                        <Button fx:id="stella1" text="★" onAction="#onStellaMichelinClicked" userData="1" styleClass="star-button, star-button-michelin"/>
                        <Button fx:id="stella2" text="★" onAction="#onStellaMichelinClicked" userData="2" styleClass="star-button, star-button-michelin"/>
                        <Button fx:id="stella3" text="★" onAction="#onStellaMichelinClicked" userData="3" styleClass="star-button, star-button-michelin"/>

                        <Region prefWidth="8"/>

                        <Button text="✖" onAction="#onAzzeraStelleMichelin" styleClass="btn-icon">
                            <tooltip>
                                <Tooltip text="Rimuovi stelle Michelin"/>
                            </tooltip>
                        </Button>
                    </HBox>
                </VBox>

                <VBox styleClass="field-group">
                    <Label text="SERVIZI OFFERTI" styleClass="field-label"/>
                    <HBox styleClass="card-tags">
                        <CheckBox fx:id="checkConsegna" text="Consegna a domicilio"/>
                        <CheckBox fx:id="checkPrenotazione" text="Prenotazione online"/>
                    </HBox>
                </VBox>

                <Label fx:id="etichettaErrore" styleClass="error-label" wrapText="true"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer">
            <Button text="Annulla" onAction="#onAnnulla" styleClass="btn-secondary"/>
            <Button fx:id="bottoneSalva" text="Salva ristorante" onAction="#onSalva" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
