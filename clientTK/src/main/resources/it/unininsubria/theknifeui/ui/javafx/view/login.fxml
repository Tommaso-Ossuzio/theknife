<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.LoginController"
            stylesheets="@style.css"
            styleClass="dialog-root"
            prefWidth="400" prefHeight="360">

    <top>
        <VBox styleClass="dialog-header">
            <Label text="Bentornato" styleClass="page-title"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="form-body">

            <VBox styleClass="field-group">
                <Label text="EMAIL" styleClass="field-label"/>
                <TextField fx:id="campoUsername" promptText="Inserisci email"/>
            </VBox>

            <VBox styleClass="field-group">
                <Label text="PASSWORD" styleClass="field-label"/>
                <PasswordField fx:id="campoPassword" promptText="Inserisci password"/>
            </VBox>

            <Label fx:id="etichettaErrore" styleClass="error-label" wrapText="true"/>

            <Pane VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer">
            <Button text="Annulla"
                    onAction="#onBack"
                    styleClass="btn-secondary"/>
            <Button fx:id="bottoneAccedi" text="Accedi"
                    onAction="#onLogin"
                    styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
