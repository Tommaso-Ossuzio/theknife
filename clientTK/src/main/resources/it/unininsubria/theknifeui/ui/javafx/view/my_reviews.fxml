<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.MyReviewsController"
            stylesheets="@style.css"
            styleClass="app-root"
            prefWidth="720" prefHeight="520">

    <top>
        <VBox styleClass="dialog-header">
            <Label text="Le mie recensioni" styleClass="page-title"/>
            <Label text="Tutti i giudizi che hai lasciato ai ristoranti."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <StackPane styleClass="content-pane">
            <TableView fx:id="tabellaRecensioni">
                <columns>
                    <TableColumn fx:id="colonnaRistorante" text="Ristorante" prefWidth="200"/>
                    <TableColumn fx:id="colonnaVoto" text="Voto" prefWidth="90"/>
                    <TableColumn fx:id="colonnaTesto" text="Recensione" prefWidth="380"/>
                </columns>
            </TableView>

            <VBox styleClass="empty-state" mouseTransparent="true">
                <Label fx:id="etichettaVuota"
                       text="Non hai ancora scritto recensioni."
                       styleClass="empty-state-text"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
