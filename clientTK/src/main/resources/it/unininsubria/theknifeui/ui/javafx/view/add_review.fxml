<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.AddReviewController"
            stylesheets="@style.css"
            styleClass="dialog-root"
            prefWidth="460" prefHeight="480">

    <top>
        <VBox styleClass="dialog-header">
            <Label fx:id="etichettaTitolo"
                   text="Aggiungi una recensione"
                   styleClass="page-title"/>
            <Label text="Il tuo giudizio aiuta gli altri a scegliere."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="form-body">

            <VBox styleClass="field-group">
                <Label text="IL TUO VOTO" styleClass="field-label"/>
                <HBox styleClass="card-line">
                    <Button fx:id="star1" text="★" onAction="#onStarClicked" userData="1" styleClass="star-button"/>
                    <Button fx:id="star2" text="★" onAction="#onStarClicked" userData="2" styleClass="star-button"/>
                    <Button fx:id="star3" text="★" onAction="#onStarClicked" userData="3" styleClass="star-button"/>
                    <Button fx:id="star4" text="★" onAction="#onStarClicked" userData="4" styleClass="star-button"/>
                    <Button fx:id="star5" text="★" onAction="#onStarClicked" userData="5" styleClass="star-button"/>
                </HBox>
            </VBox>

            <VBox styleClass="field-group" VBox.vgrow="ALWAYS">
                <Label text="LA TUA ESPERIENZA" styleClass="field-label"/>
                <TextArea fx:id="areaRecensione"
                          wrapText="true"
                          promptText="Scrivi qui cosa ti è piaciuto..."
                          VBox.vgrow="ALWAYS"/>
            </VBox>

            <Label fx:id="etichettaErrore" styleClass="error-label" wrapText="true"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer">
            <Button text="Annulla" onAction="#onAnnulla" styleClass="btn-secondary"/>
            <Button text="Pubblica recensione" onAction="#onCreate" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
