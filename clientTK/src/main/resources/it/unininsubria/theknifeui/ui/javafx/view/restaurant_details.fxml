<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="theknife.ui.javafx.RestaurantDetailsController"
      stylesheets="@style.css"
      styleClass="details-root"
      prefWidth="760"
      prefHeight="720">

    <HBox styleClass="details-header">
        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="etichettaNome" styleClass="details-title" wrapText="true"/>

            <HBox styleClass="card-line">
                <Label text="📍" styleClass="emoticon"/>
                <Label fx:id="etichettaIndirizzo" styleClass="details-line" wrapText="true"/>
            </HBox>

            <HBox styleClass="card-line">
                <Label text="🏙" styleClass="emoticon"/>
                <Label fx:id="etichettaCitta" styleClass="details-line"/>
            </HBox>
        </VBox>

        <HBox styleClass="nav-group">
            <Button fx:id="bottoneApriMaps"
                    text="Apri in Maps"
                    onAction="#onApriMaps"
                    styleClass="btn-secondary"/>
            <Button fx:id="bottonePreferiti"
                    text="Aggiungi ai preferiti"
                    onAction="#onAggiungiAiPreferiti"
                    styleClass="btn-primary"/>
        </HBox>
    </HBox>

    <GridPane hgap="12" vgap="14" styleClass="details-info-panel">
        <columnConstraints>
            <ColumnConstraints percentWidth="21"/>
            <ColumnConstraints percentWidth="29"/>
            <ColumnConstraints percentWidth="21"/>
            <ColumnConstraints percentWidth="29"/>
        </columnConstraints>
        <children>

            <!-- TODO mettere range da a, conme nel msg sul gruppo-->

            <HBox styleClass="card-line" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="💰" styleClass="emoticon"/>
                <Label text="Prezzo medio" styleClass="details-label"/>
            </HBox>
            <Label fx:id="valorePrezzo" GridPane.rowIndex="0" GridPane.columnIndex="1"
                   GridPane.valignment="CENTER" styleClass="details-value"/>

            <HBox styleClass="card-line" GridPane.rowIndex="0" GridPane.columnIndex="2">
                <Label text="⭐" styleClass="emoticon"/>
                <Label text="Stelle Michelin" styleClass="details-label"/>
            </HBox>
            <Label fx:id="valoreStelle" GridPane.rowIndex="0" GridPane.columnIndex="3"
                   GridPane.valignment="CENTER" styleClass="michelin-stars"/>

            <HBox styleClass="card-line" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="🍽" styleClass="emoticon"/>
                <Label text="Cucina" styleClass="details-label"/>
            </HBox>
            <Label fx:id="valoreCucina" GridPane.rowIndex="1" GridPane.columnIndex="1"
                   GridPane.columnSpan="3" GridPane.valignment="CENTER"
                   wrapText="true" styleClass="details-value"/>

            <Separator GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4"/>

            <HBox styleClass="card-line" GridPane.rowIndex="3" GridPane.columnIndex="0">
                <Label text="📞" styleClass="emoticon"/>
                <Label text="Telefono" styleClass="details-label"/>
            </HBox>
            <Label fx:id="valoreTelefono" GridPane.rowIndex="3" GridPane.columnIndex="1"
                   GridPane.columnSpan="3" GridPane.valignment="CENTER" styleClass="details-value"/>

            <HBox styleClass="card-line" GridPane.rowIndex="4" GridPane.columnIndex="0">
                <Label text="🌐" styleClass="emoticon"/>
                <Label text="Sito web" styleClass="details-label"/>
            </HBox>
            <Hyperlink fx:id="linkSitoWeb" GridPane.rowIndex="4" GridPane.columnIndex="1"
                       GridPane.columnSpan="3" GridPane.valignment="CENTER" maxWidth="Infinity"/>

            <!-- TODO aggiungere media recensioni-->

            <HBox styleClass="card-line" GridPane.rowIndex="5" GridPane.columnIndex="0">
                <Label text="🚚" styleClass="emoticon"/>
                <Label text="Consegna" styleClass="details-label"/>
            </HBox>
            <Label fx:id="valoreConsegna" GridPane.rowIndex="5" GridPane.columnIndex="1"
                   GridPane.valignment="CENTER" styleClass="details-value"/>

            <HBox styleClass="card-line" GridPane.rowIndex="5" GridPane.columnIndex="2">
                <Label text="📅" styleClass="emoticon"/>
                <Label text="Prenotazione" styleClass="details-label"/>
            </HBox>
            <Label fx:id="valorePrenotazione" GridPane.rowIndex="5" GridPane.columnIndex="3"
                   GridPane.valignment="CENTER" styleClass="details-value"/>
        </children>
    </GridPane>

    <Label text="Sito web del ristorante" styleClass="section-title"/>

    <WebView fx:id="vistaSito"
             prefWidth="680.0"
             prefHeight="420.0"
             minHeight="260.0"
             VBox.vgrow="ALWAYS">
        <styleClass>
            <String fx:value="details-map"/>
        </styleClass>
    </WebView>

    <HBox styleClass="nav-group">
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Chiudi" onAction="#onChiudi" styleClass="btn-secondary"/>
    </HBox>
</VBox>
