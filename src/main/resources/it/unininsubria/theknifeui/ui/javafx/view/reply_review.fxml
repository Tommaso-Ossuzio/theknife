<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.ReplyReviewsController"
            stylesheets="@style.css"
            styleClass="app-root"
            prefWidth="640" prefHeight="700">

    <top>
        <VBox styleClass="dialog-header">
            <Label text="Gestione recensioni" styleClass="page-title"/>
            <Label text="Qui puoi rispondere alle recensioni ricevute nei tuoi ristoranti."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <!-- TODO una volta scritta la risposta va tolta dalla lista -->

    <center>
        <VBox styleClass="content-pane">
            <ListView fx:id="listaRecensioni" styleClass="review-list" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Non hai ancora ricevuto recensioni." styleClass="muted-text"/>
                </placeholder>
            </ListView>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer">
            <Button text="Chiudi" onAction="#onChiudi" styleClass="btn-secondary"/>
        </HBox>
    </bottom>

</BorderPane>
