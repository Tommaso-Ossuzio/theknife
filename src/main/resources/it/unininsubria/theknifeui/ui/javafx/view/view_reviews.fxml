<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.ViewReviewsController"
            stylesheets="@style.css"
            styleClass="app-root"
            prefWidth="540" prefHeight="620">

    <top>
        <VBox styleClass="dialog-header">
            <Label fx:id="etichettaTitolo"
                   text="Recensioni"
                   styleClass="page-title"/>

            <HBox styleClass="card-tags">
                <Label fx:id="etichettaMedia"
                       text="Media stelle: -"
                       styleClass="tag, tag-accent"/>
                <Label fx:id="etichettaConteggio"
                       text="Numero di recensioni: 0"
                       styleClass="tag"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-pane">
            <ListView fx:id="listaRecensioni" styleClass="review-list" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Non ci sono ancora recensioni." styleClass="muted-text"/>
                </placeholder>
            </ListView>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer">
            <Button text="Chiudi" onAction="#onChiudi" styleClass="btn-secondary"/>
        </HBox>
    </bottom>

</BorderPane>
