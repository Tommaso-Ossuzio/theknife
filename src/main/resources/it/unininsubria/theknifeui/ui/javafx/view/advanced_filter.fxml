<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.ui.javafx.AdvancedFilterController"
            stylesheets="@style.css"
            styleClass="dialog-root"
            prefWidth="460" prefHeight="560">

    <top>
        <VBox styleClass="dialog-header">
            <Label text="Filtri avanzati" styleClass="page-title"/>
            <Label text="Restringi la ricerca per trovare esattamente quello che cerchi."
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="form-body">

            <VBox styleClass="field-group">
                <Label text="LUOGO" styleClass="field-label"/>
                <TextField fx:id="campoLuogo" promptText="Città, indirizzo..."/>
            </VBox>

            <VBox styleClass="field-group">
                <Label text="CUCINA" styleClass="field-label"/>
                <TextField fx:id="campoCucina" promptText="Italian, Sushi, ecc..."/>
            </VBox>

            <VBox styleClass="field-group">
                <Label text="FASCIA DI PREZZO (€)" styleClass="field-label"/>
                <HBox styleClass="card-line">
                    <TextField fx:id="campoPrezzoMin" promptText="Min" HBox.hgrow="ALWAYS"/>
                    <Label text="—" styleClass="muted-text"/>
                    <TextField fx:id="campoPrezzoMax" promptText="Max" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox styleClass="field-group">
                <Label text="MEDIA STELLE (MINIMO)" styleClass="field-label"/>
                <HBox styleClass="card-line">
                    <Button fx:id="star1" text="★" onAction="#onStarClicked" userData="1" styleClass="star-button, star-button-small"/>
                    <Button fx:id="star2" text="★" onAction="#onStarClicked" userData="2" styleClass="star-button, star-button-small"/>
                    <Button fx:id="star3" text="★" onAction="#onStarClicked" userData="3" styleClass="star-button, star-button-small"/>
                    <Button fx:id="star4" text="★" onAction="#onStarClicked" userData="4" styleClass="star-button, star-button-small"/>
                    <Button fx:id="star5" text="★" onAction="#onStarClicked" userData="5" styleClass="star-button, star-button-small"/>

                    <Region prefWidth="8"/>

                    <Button text="✖" onAction="#onResetStars" styleClass="btn-icon">
                        <tooltip>
                            <Tooltip text="Rimuovi filtro stelle"/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>

            <VBox styleClass="field-group">
                <Label text="SERVIZI EXTRA" styleClass="field-label"/>
                <HBox styleClass="card-tags">
                    <CheckBox fx:id="checkDelivery" text="Consegna a domicilio"/>
                    <CheckBox fx:id="checkBooking" text="Prenotazione online"/>
                </HBox>
            </VBox>

            <Pane VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer">
            <Button text="Annulla" onAction="#onCancel" styleClass="btn-secondary"/>
            <Button text="Applica filtri" onAction="#onApply" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
